# Backend settings use the INVOLO_ prefix (pydantic-settings).
# Copy to .env and adjust. Never commit real secrets or session files.

# Application
INVOLO_ENVIRONMENT=development
INVOLO_API_PREFIX=/api/v1
INVOLO_CORS_ORIGINS=http://localhost:8020

# Auth
INVOLO_JWT_SECRET=replace-with-at-least-32-random-characters
INVOLO_ACCESS_TOKEN_MINUTES=15
INVOLO_REFRESH_TOKEN_DAYS=30
INVOLO_COOKIE_SECURE=true
INVOLO_COOKIE_SAMESITE=none
# Optional idempotent admin bootstrap (both required together)
INVOLO_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
INVOLO_BOOTSTRAP_ADMIN_PASSWORD=change-me

# Infrastructure (compose overrides hostnames for containers)
INVOLO_MONGO_URI=mongodb://localhost:8022
INVOLO_MONGO_DATABASE=involo
INVOLO_REDIS_URL=redis://localhost:8028/0
INVOLO_QDRANT_URL=http://localhost:8024
INVOLO_QDRANT_API_KEY=
# Live provider probes are required in production. Development may disable them.
INVOLO_PROVIDER_READINESS_PROBES_ENABLED=true
INVOLO_PROVIDER_READINESS_CACHE_TTL_SECONDS=30
# The EC2 staging instance is in eu-west-3 while S3/Bedrock buckets are in
# us-east-1, so cross-region probes may exceed the 3-second default. Keep 10s.
INVOLO_PROVIDER_READINESS_TIMEOUT_SECONDS=10
INVOLO_QDRANT_TREND_COLLECTION=trend_content_v2
INVOLO_QDRANT_USER_COLLECTION=user_profiles_v2
INVOLO_QDRANT_USER_CONTENT_COLLECTION=user_content_v2
INVOLO_QDRANT_SEGMENT_COLLECTION=content_segments_v2
INVOLO_VECTOR_SIZE=1024
INVOLO_VECTOR_SCHEMA_VERSION=nova-mm-v2
INVOLO_VECTOR_FUSION_TEXT_WEIGHT=0.45
INVOLO_VECTOR_FUSION_MEDIA_WEIGHT=0.55

# Scraper (Phase 2)
# Supported: fixture (local/no network), instagram (Playwright), meta (Graph API).
INVOLO_SCRAPER_ADAPTER=fixture
INVOLO_INSTAGRAM_USERNAME=
INVOLO_INSTAGRAM_PASSWORD=
INVOLO_SCRAPER_STORAGE_STATE_PATH=.state/instagram.json
# Run Playwright browser in headless mode (required in Docker; default true).
INVOLO_SCRAPER_HEADLESS=true
# Skip Instagram content older than this many days during scraping (0 = no limit).
INVOLO_SCRAPER_MAX_CONTENT_AGE_DAYS=30
# Set to false to skip auto-installing Playwright Chromium on every start.
# Default is true; the install is idempotent and uses cache after the first download.
# Install once manually with:
#   source backend/.venv/bin/activate && python -m playwright install chromium chromium-headless-shell
INVOLO_INSTALL_PLAYWRIGHT=true

# Metadata / scoring / transcript (Phase 3)
# S3 buckets for transcription and media processing. All must be in the same region
# as the Bedrock generation/embedding regions below.
INVOLO_TRANSCRIBE_S3_BUCKET=involo-trendy-poc-staging-transcribe
INVOLO_MEDIA_S3_BUCKET=involo-trendy-poc-staging-media
INVOLO_MEDIA_S3_REGION=us-east-1
# Optional 12-digit AWS account ID required for cross-account Bedrock S3 media access.
INVOLO_MEDIA_S3_BUCKET_OWNER=
# Nova multimodal embeddings currently run in us-east-1 and require regional S3 media.
INVOLO_EMBEDDING_MEDIA_S3_BUCKET=involo-trendy-poc-staging-embedding-media
INVOLO_EMBEDDING_MEDIA_S3_REGION=us-east-1
INVOLO_EMBEDDING_MEDIA_S3_BUCKET_OWNER=
INVOLO_MEDIA_S3_PREFIX=content-intelligence
INVOLO_MEDIA_RETENTION_DAYS=30
INVOLO_MEDIA_MAX_DOWNLOAD_BYTES=250000000
INVOLO_KEYFRAME_OFFSETS_SECONDS=0,1,3,5
INVOLO_SEGMENT_SECONDS=15
# Use 'aws' for real AWS Transcribe; use 'fake' for local development without AWS credentials.
INVOLO_TRANSCRIPTION_PROVIDER=fake
INVOLO_MEDIA_PROVIDER=noop
INVOLO_SCORE_DISTRIBUTION_WEIGHT=0.40
INVOLO_SCORE_ENGAGEMENT_WEIGHT=0.30
INVOLO_SCORE_VELOCITY_WEIGHT=0.30
INVOLO_SCORE_COMMENT_WEIGHT=5.0
INVOLO_SCORE_SHARE_WEIGHT=12.0
INVOLO_SCORE_DISTRIBUTION_RATIO_DIVISOR=2.0
INVOLO_SCORE_ENGAGEMENT_RATE_MULTIPLIER=6.0
INVOLO_SCORE_VELOCITY_LOG_DIVISOR=7.0
# Fallback metadata provider for missing view_count/video_duration on zero-score retries:
#   none   = use discovered metadata only
#   ytdlp  = try public yt-dlp extraction
#   graph  = use Meta Graph API (requires meta_trend_access_token)
#   all    = try Graph API first, then yt-dlp (not recommended for public posts)
INVOLO_METADATA_FALLBACK_PROVIDER=none
INVOLO_MAX_ZERO_SCORE_ENRICHMENT_RETRIES=3
INVOLO_ZERO_SCORE_ENRICHMENT_COOLDOWN_MINUTES=0
INVOLO_FFMPEG_BINARY=ffmpeg
INVOLO_FFPROBE_BINARY=ffprobe

# Embedding (Phase 4)
# For local development, use the fake providers so the pipeline runs without real
# AWS/Bedrock credentials. Keep the embedding region the same as the media region.
INVOLO_BEDROCK_EMBEDDING_REGION=us-east-1
INVOLO_BEDROCK_GENERATION_REGION=us-east-1
INVOLO_BEDROCK_EMBEDDING_MODEL_ID=amazon.nova-2-multimodal-embeddings-v1:0
INVOLO_BEDROCK_VISION_MODEL_ID=us.amazon.nova-pro-v1:0
# Use 'aws' for real Bedrock; use 'fake' for local development.
INVOLO_EMBEDDING_PROVIDER=fake
INVOLO_VISION_PROVIDER=fake
INVOLO_EMBEDDING_MEDIA_S3_BUCKET=involo-trendy-poc-staging-embedding-media
INVOLO_EMBEDDING_MEDIA_S3_REGION=us-east-1

# Instagram user profiling (Phase 5)
INVOLO_INSTAGRAM_GRAPH_API_VERSION=v25.0
# Facebook App credentials for graph.facebook.com endpoints (long-lived token exchange,
# hashtag search, business discovery). Use the main App ID and App Secret from the top of
# App Dashboard > Settings > Basic. These differ from the Instagram App credentials below.
# If omitted, the system falls back to INVOLO_INSTAGRAM_APP_ID / INVOLO_INSTAGRAM_APP_SECRET.
INVOLO_FACEBOOK_APP_ID=
INVOLO_FACEBOOK_APP_SECRET=
# Use the Instagram App ID from App Dashboard > Instagram > API setup with Instagram login
# > Business login settings > Instagram App ID. NOT the Facebook App ID at the top of the
# dashboard. Using the Facebook App ID causes the "Invalid platform app" OAuth error.
INVOLO_INSTAGRAM_APP_ID=
INVOLO_INSTAGRAM_APP_SECRET=
# Long-lived token with approved Instagram Public Content/Hashtag permissions.
# The token is read once from .env to seed the managed token store in MongoDB, then
# automatically refreshed before it expires. After the first run you can leave this
# empty and the system will use the stored, encrypted token.
INVOLO_META_INSTAGRAM_BUSINESS_ACCOUNT_ID=
INVOLO_INSTAGRAM_OAUTH_REDIRECT_URI=https://trendy-staging.involo.co/api/v1/instagram/oauth/callback
# Meta Webhooks verify token. Must match the value in App Dashboard > Webhooks > Verify token.
INVOLO_INSTAGRAM_WEBHOOK_VERIFY_TOKEN=
# URL the backend redirects to after Instagram OAuth callback.
# run-local.sh / run.sh override this to the local frontend; deploy.sh sets the Vercel frontend for Docker deployments.
INVOLO_INSTAGRAM_OAUTH_SUCCESS_URL=http://localhost:8020/instagram/callback
# Public HTTPS domain for Instagram OAuth and API (legacy, replaced by ALB in staging).
# Leave empty for local development.
INVOLO_NGROK_DOMAIN=
INVOLO_TUNNEL_STRICT=false
# Use a long, random production secret. Changing it invalidates stored tokens.
INVOLO_INSTAGRAM_TOKEN_ENCRYPTION_KEY=development-only-token-encryption-key
INVOLO_BEDROCK_PROFILE_MODEL_ID=us.amazon.nova-pro-v1:0
INVOLO_PROFILING_SCHEDULE_ENABLED=false
INVOLO_PROFILING_SCHEDULE_CRON=
# Bound concurrent media downloads/transcriptions/embeddings during profiling.
INVOLO_PROFILING_MAX_CONCURRENCY=3

# Creator tracking (daily 03:00 UTC+3 = 00:00 UTC; Instagram Graph API)
# Supported: graph_api (production, via Meta Business Discovery),
# fixture (local/no network), or playwright (headless browser scraping).
INVOLO_CREATOR_TRACKING_PROVIDER=fixture
INVOLO_CREATOR_TRACKING_HEADLESS=true
INVOLO_CREATOR_TRACKING_SCHEDULE_ENABLED=true
INVOLO_CREATOR_TRACKING_MAX_POSTS=12
# Delay in ms between each creator during bulk track_all runs (helps avoid Graph API rate limits).
INVOLO_CREATOR_TRACKING_BATCH_DELAY_MS=100
INVOLO_CREATOR_AI_PROFILE_ENABLED=true

# Content recommendations (Phase 6)
INVOLO_BEDROCK_RECOMMENDATION_MODEL_ID=us.amazon.nova-pro-v1:0
INVOLO_RECOMMENDATION_DEFAULT_COUNT=3
INVOLO_RECOMMENDATION_RETRIEVAL_TOP_K=10
INVOLO_RECOMMENDATION_RETRIEVAL_POOL=30
INVOLO_RECOMMENDATION_VIRAL_WEIGHT=0.2
INVOLO_RECOMMENDATION_HISTORY_LIMIT=20
INVOLO_RECOMMENDATION_DEDUPE_THRESHOLD=0.9
INVOLO_RECOMMENDATION_MAX_ATTEMPTS=3
INVOLO_RECOMMENDATION_PROMPT_CACHE=true
INVOLO_RECOMMENDATION_MMR_LAMBDA=0.7
INVOLO_RECOMMENDATION_MIN_CONFIDENCE=0.25
INVOLO_SNAPSHOT_OFFSETS_HOURS=6,24,48,72
INVOLO_OUTCOME_OFFSETS_HOURS=24,72
INVOLO_PROVIDER_COST_PER_1K_INPUT_TOKENS=0
INVOLO_PROVIDER_COST_PER_1K_OUTPUT_TOKENS=0
INVOLO_EVALUATION_MIN_NDCG_AT_K=0.5
INVOLO_EVALUATION_MIN_PRECISION_AT_K=0.2
INVOLO_EVALUATION_MAX_BRIER=0.25
INVOLO_EVALUATION_MAX_P95_LATENCY_SECONDS=30
INVOLO_EVALUATION_MAX_COST_PER_PREDICTION=1
INVOLO_EVALUATION_ROLLBACK_NDCG_DROP=0.1
INVOLO_EVALUATION_ROLLBACK_PRECISION_DROP=0.1
INVOLO_EVALUATION_ROLLBACK_BRIER_INCREASE=0.05

# Instagram brand reference analysis
INVOLO_BRAND_ANALYSIS_MAX_POSTS=10
INVOLO_BRAND_ANALYSIS_PUBLIC_FALLBACK_ENABLED=false
INVOLO_BRAND_ANALYSIS_PROVIDER=fake
# Number of posts analyzed in parallel with AI (limits Bedrock concurrency).
INVOLO_BRAND_ANALYSIS_CONCURRENCY=3
# Max posts included in the final markdown report context.
INVOLO_BRAND_ANALYSIS_MAX_REPORT_POSTS=30
# Enable Amazon Bedrock prompt cache when supported by the model/region.
INVOLO_BEDROCK_ENABLE_PROMPT_CACHE=false
# Optional: override Bedrock model IDs used for brand analysis caption/report.
INVOLO_BRAND_ANALYSIS_REPORT_MODEL_ID=us.amazon.nova-pro-v1:0
INVOLO_BRAND_ANALYSIS_CAPTION_MODEL_ID=us.amazon.nova-lite-v1:0
INVOLO_BRAND_ANALYSIS_REPORT_MAX_TOKENS=5000
INVOLO_BRAND_ANALYSIS_CAPTION_MAX_TOKENS=1000
INVOLO_BEDROCK_VISION_MAX_TOKENS=2048
# PDF export: 'playwright' uses the installed Chromium browser; 'fake' returns placeholder bytes.
INVOLO_BRAND_ANALYSIS_PDF_PROVIDER=playwright
INVOLO_BRAND_ANALYSIS_PDF_TIMEOUT_SECONDS=60
# Keyframe offsets used only for brand analysis video posts (fewer frames = faster).
INVOLO_BRAND_ANALYSIS_KEYFRAME_OFFSETS_SECONDS=0,2.5,5

# Official read-only topic signal connectors (never treated as Instagram metrics)
INVOLO_TOPIC_SIGNALS_SCHEDULE_ENABLED=true
INVOLO_GOOGLE_TRENDS_ENABLED=false
# Set to the endpoint granted with your official Google Trends API alpha access.
INVOLO_GOOGLE_TRENDS_API_URL=
INVOLO_GOOGLE_TRENDS_API_KEY=
INVOLO_YOUTUBE_SIGNALS_ENABLED=false
INVOLO_YOUTUBE_API_KEY=
INVOLO_REDDIT_SIGNALS_ENABLED=false
INVOLO_REDDIT_CLIENT_ID=
INVOLO_REDDIT_CLIENT_SECRET=
INVOLO_REDDIT_USER_AGENT=involo-content-intelligence/1.0

# Live scraper log stream (Phase 7)
INVOLO_SCRAPER_LOG_MAX_LINES=500
INVOLO_SCRAPER_LOG_TTL_SECONDS=3600
INVOLO_SCRAPER_LOG_PERSIST_LINES=200

# Hardening: retry/backoff + rate limiting + stale cleanup (Phase 8)
INVOLO_TASK_MAX_RETRIES=3
INVOLO_TASK_RETRY_BACKOFF_MAX=300
INVOLO_STALE_JOB_CLEANUP_HOURS=24
INVOLO_RATE_LIMIT_ENABLED=true
INVOLO_AUTH_RATE_LIMIT_MAX=10
INVOLO_AUTH_RATE_LIMIT_WINDOW_SECONDS=60
INVOLO_RECOMMENDATION_RATE_LIMIT_MAX=20
INVOLO_RECOMMENDATION_RATE_LIMIT_WINDOW_SECONDS=3600
# Graph API app-level rate limit (Meta: 200 calls per user per hour).
# User count is the number of users connected to the Meta app. Increase it to raise
# the global budget; the default (1) is safe but conservative.
INVOLO_GRAPH_RATE_LIMIT_ENABLED=true
INVOLO_GRAPH_RATE_LIMIT_USER_COUNT=1
INVOLO_GRAPH_RATE_LIMIT_CALLS_PER_USER=200
INVOLO_GRAPH_RATE_LIMIT_WINDOW_SECONDS=3600

# Default AWS region is used by Transcribe; Bedrock stages use the regions above.
INVOLO_AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Explicit credential-dependent smoke tests. Keep disabled in normal test runs.
INVOLO_RUN_REAL_AWS_SMOKE=0
INVOLO_RUN_REAL_S3_SMOKE=0
INVOLO_RUN_REAL_MEDIA_SMOKE=0
INVOLO_RUN_REAL_INSTAGRAM_SMOKE=0
INVOLO_RUN_REAL_INSTAGRAM_PROFILE_SMOKE=0
INVOLO_RUN_REAL_META_SMOKE=0
INVOLO_INSTAGRAM_TEST_ACCESS_TOKEN=
INVOLO_META_SMOKE_HASHTAG=travel

# Frontend (browser-visible; never put secrets here)
NEXT_PUBLIC_API_URL=http://localhost:8021
INVOLO_META_TREND_ACCESS_TOKEN=
